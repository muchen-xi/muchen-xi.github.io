# dr-agent 配置模板（安装后位于 /etc/dr-agent.env，权限必须 600）
#
# 语法：systemd EnvironmentFile —— KEY=VALUE，# 开头为注释，值可用双引号。
# 改完执行: sudo systemctl restart dr-agent
# 校验:     sudo /usr/bin/python3 /opt/dr-agent/dr_agent.py --selftest

# ── 阿里云 DNS 凭据（与 monitoring/scripts/*.py、GitHub secrets 同套） ──
ALI_KEY_ID=
ALI_KEY_SECRET=
ALI_REGION=cn-hangzhou

# ── 运行角色 ──
# switch_only = 阶段一（默认）：只执行切换；恢复判定只记录 + 发告警，不动 DNS
# full        = 阶段二：按契约第四节执行恢复（peer 闸门 + 最小驻留 1800s + 恢复前逐 IP 可达校验）
DR_ROLE=switch_only

# ── 容灾目标（逗号分隔；支持 www / starkeeper） ──
DR_TARGETS=www,starkeeper

# ── 探测节奏（秒） ──
DR_TICK_SECONDS=30              # 常驻循环 tick；slow 模式每 tick 做轻探
DR_FULL_PROBE_SECONDS=300       # slow 模式下完整探测间隔
DR_FAST_PROBE_SECONDS=30        # fast（可疑）模式下完整探测间隔，通常 = tick
# 轻探模式：
#   curl = 真发一次 HTTPS 请求（带白名单 UA）→ 能看出 5xx/TLS/证书/WAF 问题，
#          代价是每个 tick 一次 TLS 握手（Zero W 上约 2~3 秒 CPU）
#   tcp  = 只做三次握手（几百毫秒、零应用层开销）→ 但 TCP 通不代表站点可用
DR_LIGHT_PROBE=curl

# ── 判定阈值 ──
DR_TCP_FAILS_TO_ESCALATE=2      # TCP 轻探连续失败 N 次 → 升 fast（兼容旧拼写 DR_TCP_FAILS_TO_ESCAPE）
DR_FAILS_TO_SWITCH=3            # 完整探测连续不健康 N 次 → 执行切换
DR_STREAK_TO_RESTORE=3          # 完整探测连续健康 N 次 → 具备恢复条件（仅 DR_ROLE=full 执行）
DR_MIN_DWELL_SECONDS=1800       # 最小驻留时间：距 _dr-snap.ts 不足则恢复被闸门拦下
DR_PEER_MAX_AGE_SECONDS=1200    # peer(_dr-gh) 新鲜度；超时视为 stale（失联不阻断恢复）
DR_CLOCK_SKEW_MAX=300           # 时钟偏差上限（秒）；超限拒绝一切 DNS 写操作
DR_CLOCK_CHECK_SECONDS=1800     # 校时间隔（启动时必校）

# ── 开关 ──
DR_ALERT_ENABLED=1              # 0 = 全关告警与心跳邮件
DR_DRY_RUN=0                    # 1 = 不写 DNS / 不写 TXT / 不发邮件（等价 CLI --dry-run）
DR_SWITCH_ENABLED=1             # 0 = 只闸住 DNS 写：判定满足时只告警不切换（上线验证 AK/TXT/邮件全链路用）
DR_BOARD_WRITE_SECONDS=300      # _dr-pi 心跳最小写入间隔（verdict/fails/fast/net/mode 变化时立即写，不受此限）

# ── 告警邮件（SMTP_SSL） ──
SMTP_SERVER=smtp.qiye.aliyun.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_NAME="晨曦的宇宙 · 树莓派观察者"
REPORT_TO=                      # 收件人，多个用英文逗号分隔
